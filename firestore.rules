rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isOwner(data) {
      return true; // Acceso público solicitado
    }

    function isSignedIn() {
      return true; // Acceso público solicitado
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints
    function isValidQuote(data) {
      return data.keys().hasAll(['type', 'modality', 'userVolume', 'location', 'environment', 'techPlatform', 'clientName', 'clientNit', 'clientEmail', 'clientPhone', 'status', 'createdAt']) &&
             data.type in ['bootcamp', 'cursos', 'crea academy'] &&
             data.modality in ['presencial', 'virtual'] &&
             data.userVolume in ['<50', '>50'] &&
             data.location in ['metropolitana', 'fuera'] &&
             data.environment in ['google', 'microsoft'] &&
             data.techPlatform in ['claude', 'notebooklm', 'google ai studio', 'otros'] &&
             data.clientName is string && data.clientName.size() <= 200 &&
             data.clientNit is string && data.clientNit.size() <= 50 &&
             data.clientEmail is string &&
             data.clientPhone is string && data.clientPhone.size() <= 30 &&
             data.status in ['pendiente', 'enviada', 'aceptada', 'rechazada'];
    }

    function isValidOpportunity(data) {
      return data.keys().hasAll(['quoteId', 'status', 'createdAt']) &&
             data.quoteId is string &&
             data.status in ['seguimiento', 'ganada', 'perdida'];
    }

    match /quotes/{quoteId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isValidId(quoteId) && 
                      isValidQuote(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isValidQuote(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().updatedAt == request.time;
      
      allow delete: if true;
    }

    match /opportunities/{opportunityId} {
      allow get: if true;
      allow list: if true;
      
      allow create: if isValidId(opportunityId) &&
                      isValidOpportunity(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isValidOpportunity(incoming()) &&
                      incoming().createdAt == existing().createdAt;
      
      allow delete: if true;
    }
  }
}
